# The automation reads these from the process environment. This file is only
# a name/reference template; do not put a real Gmail app password in Git.
MAPLE_REPORT_TO_EMAIL=
MAPLE_SMTP_USERNAME=
MAPLE_SMTP_APP_PASSWORD=

# Optional Gmail SMTP transport overrides.
MAPLE_SMTP_HOST=smtp.gmail.com
MAPLE_SMTP_PORT=465
